# ==============================================================
# DeepBI Agent — Ortam Değişkenleri Yapılandırma Dosyası
# Bu dosyayı kopyalayıp `.env` olarak kaydedin:
#   cp .env.example .env
# ==============================================================

# ---------------------------------------------------------------
# 1. DEEPSEEK / LLM API AYARLARI
# ---------------------------------------------------------------
# DeepSeek API anahtarınız (https://platform.deepseek.com'dan alın)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DeepSeek API Endpoint (veya OpenAI uyumlu başka bir model sağlayıcı)
# Varsayılan: https://api.deepseek.com/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Kullanılacak model adı
DEEPSEEK_MODEL=deepseek-chat

# ---------------------------------------------------------------
# 2. FASTAPI SUNUCU AYARLARI
# ---------------------------------------------------------------
# Sunucu dinleme adresi ve portu
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Güvenlik: İzin verilen frontend CORS kaynaklari (virgülle ayrılmış)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT Token imzalama sırrı (üretimde uzun ve güçlü olmalı)
SECRET_KEY=changeme_super_secret_key_32chars_min
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ---------------------------------------------------------------
# 3. VERİTABANI BAĞLANTI AYARLARI (Uzak Sunucular)
# ---------------------------------------------------------------
# --- PostgreSQL ---
# PG_HOST=localhost
# PG_PORT=5432
# PG_DB=deepbi
# PG_USER=readonly_user
# PG_PASSWORD=sifreniz

# --- MySQL / MariaDB ---
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_DB=deepbi
# MYSQL_USER=readonly_user
# MYSQL_PASSWORD=sifreniz

# --- MSSQL / SQL Server (Gelecek sürümde) ---
# MSSQL_HOST=localhost
# MSSQL_PORT=1433
# MSSQL_DB=deepbi
# MSSQL_USER=readonly_user
# MSSQL_PASSWORD=sifreniz
# MSSQL_DRIVER=ODBC Driver 17 for SQL Server

# --- SAP S/4HANA (HANA - Aktif Desteğe Sahip) ---
# HANA_HOST=hanahostname.example.com
# HANA_PORT=30015
# HANA_USER=READONLY_USER
# HANA_PASSWORD=sifreniz
# HANA_SCHEMA=S4H

# ---------------------------------------------------------------
# 4. DOSYA DEPOLAMA AYARLARI
# ---------------------------------------------------------------
# Yüklenen Excel/CSV dosyalarının kaydedileceği dizin
UPLOAD_DIR=./uploads

# Maksimum dosya yükleme boyutu (MB)
MAX_UPLOAD_SIZE_MB=50

# İzin verilen dosya uzantıları (virgülle ayrılmış)
ALLOWED_EXTENSIONS=.xlsx,.xls,.csv,.tsv

# ---------------------------------------------------------------
# 5. SANDBOX AYARLARI
# ---------------------------------------------------------------
# Sandbox kod çalıştırma zaman aşımı (saniye)
SANDBOX_TIMEOUT_SECONDS=10

# Sandbox maksimum bellek kullanımı (MB)
SANDBOX_MAX_MEMORY_MB=512

# ---------------------------------------------------------------
# 6. RAG / BELLEK AYARLARI
# ---------------------------------------------------------------
# Sorgu hafızası dosyası yolu
MEMORY_FILE=./query_memory.json

# RAG vektör aramasında döndürülecek maksimum örnek sayısı
RAG_TOP_K=3

# Self-RAG Auto-Correct maksimum deneme sayısı
RAG_MAX_CORRECT_ATTEMPTS=3

# ---------------------------------------------------------------
# 7. LOGLAMA AYARLARI
# ---------------------------------------------------------------
# Log seviyesi: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Log dosyası yolu (boş bırakılırsa stdout'a yazar)
LOG_FILE=./deepbi.log
